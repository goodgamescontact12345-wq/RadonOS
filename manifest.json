{
  "manifest_version": 3,
  "name": "RadonOS",
  "short_name": "RadonOS",
  "version": "1.0.0",
  "description": "A full virtual desktop in your new tab: windowed apps, virtual file system, widgets, terminal and more.",
  "minimum_chrome_version": "116",
  "offline_enabled": true,
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open RadonOS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "commands": {
    "open-radonos": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open RadonOS in a new tab"
    }
  }
}
