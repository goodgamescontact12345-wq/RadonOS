{
  "name": "radonos",
  "version": "1.0.0",
  "private": true,
  "description": "RadonOS — a virtual desktop environment for the browser new tab page (Chromium Manifest V3 extension).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "icons": "node tools/make-icons.mjs",
    "validate": "node tools/validate.mjs",
    "test:sw": "node tools/sw-test.mjs",
    "test:platform": "node tools/platform-test.mjs",
    "test": "node tools/validate.mjs && node tools/sw-test.mjs && node tools/platform-test.mjs",
    "e2e": "node tools/e2e.mjs",
    "e2e:web": "node tools/e2e.mjs --web",
    "e2e:headed": "node tools/e2e.mjs --headed",
    "site:build": "node tools/build-site.mjs",
    "site:dev": "node tools/build-site.mjs && wrangler dev --config site/wrangler.toml --port 8787",
    "site:test": "node tools/site-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
